      "claims": [
        {
          "id": 54,
          "cluster_id": 5,
          "text": "The National Payments Corporation of India (NPCI) introduced a Merchant Discount Rate (MDR) framework for the Unified Payments Interface (UPI) effective from October 15.",
          "kind": "event",
          "outlet": "NDTV",
          "url": "https://www.ndtv.com/india-news/upi-charges-explained-who-pays-for-upi-transactions-how-much-is-upi-charge-12051163#publisher=newsstand",
          "source_kind": "fulltext"
        },
        {
          "id": 55,
          "cluster_id": 5,
          "text": "Under the new NPCI framework, customers will pay no charges for making UPI payments regardless of transaction value.",
          "kind": "event",
          "outlet": "NDTV",
          "url": "https://www.ndtv.com/india-news/upi-charges-explained-who-pays-for-upi-transactions-how-much-is-upi-charge-12051163#publisher=newsstand",
          "source_kind": "fulltext"
        },
        {
          "id": 56,
          "cluster_id": 5,
          "text": "Merchants receiving UPI payments above Rs 2,000 in a single transaction will be levied a 0.4% Merchant Discount Rate (MDR), with an upper cap of Rs 300.",
          "kind": "figure",
          "outlet": "NDTV",
          "url": "https://www.ndtv.com/india-news/upi-charges-explained-who-pays-for-upi-transactions-how-much-is-upi-charge-12051163#publisher=newsstand",
          "source_kind": "fulltext"
        },
        {
          "id": 57,
          "cluster_id": 5,
          "text": "The Finance Ministry stated that MDR fees collected will be distributed among payment ecosystem participants, including banks and app providers, to support operations and expansion.",
          "kind": "event",
          "outlet": "NDTV",
          "url": "https://www.ndtv.com/india-news/upi-charges-explained-who-pays-for-upi-transactions-how-much-is-upi-charge-12051163#publisher=newsstand",
          "source_kind": "fulltext"
        },
        {
          "id": 58,
          "cluster_id": 5,
          "text": "Person-to-person UPI transfers account for 70% of total UPI transaction value and will remain completely free for individuals.",
          "kind": "figure",
          "outlet": "NDTV",
          "url": "https://www.ndtv.com/india-news/upi-charges-explained-who-pays-for-upi-transactions-how-much-is-upi-charge-12051163#publisher=newsstand",
          "source_kind": "fulltext"
        },
        {
          "id": 59,
          "cluster_id": 5,
          "text": "Small merchants receiving up to Rs 1 lakh per month will pay no fees on incoming UPI payments.",
          "kind": "background",
          "outlet": "NDTV",
          "url": "https://www.ndtv.com/india-news/upi-charges-explained-who-pays-for-upi-transactions-how-much-is-upi-charge-12051163#publisher=newsstand",
          "source_kind": "fulltext"
        },
        {
          "id": 60,
          "cluster_id": 5,
          "text": "A flat MDR rate of Rs 5 will apply to UPI transactions above Rs 2,000 in essential sectors including railways, telecommunications, insurance, fuel, and agricultural inputs.",
