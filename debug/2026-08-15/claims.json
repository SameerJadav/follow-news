        "fulltext": 10
      },
      "claims": [
        {
          "id": 1,
          "cluster_id": 0,
          "text": "US President Donald Trump stated at a rally in Garden City, New York, that he would soon declare the Strait of Hormuz a US territory.",
          "kind": "event",
          "outlet": "DW World",
          "url": "https://www.dw.com/en/donald-trump-to-declare-hormuz-us-territory-soon/a-78377755?maca=en-rss-en-world-4025-rdf",
          "source_kind": "fulltext"
        },
        {
          "id": 2,
          "cluster_id": 0,
          "text": "Iran's Deputy Foreign Minister Kazem Gharibabadi rejected Donald Trump's remarks and stated that the Strait of Hormuz would remain under Iranian control.",
          "kind": "event",
          "outlet": "DW World",
          "url": "https://www.dw.com/en/donald-trump-to-declare-hormuz-us-territory-soon/a-78377755?maca=en-rss-en-world-4025-rdf",
          "source_kind": "fulltext"
        },
        {
          "id": 3,
          "cluster_id": 0,
          "text": "The United States and Israel launched a war against Iran on February 28.",
          "kind": "background",
          "outlet": "DW World",
          "url": "https://www.dw.com/en/donald-trump-to-declare-hormuz-us-territory-soon/a-78377755?maca=en-rss-en-world-4025-rdf",
          "source_kind": "fulltext"
        },
        {
          "id": 4,
          "cluster_id": 0,
          "text": "Prior to the war, one-fifth of the world's oil and liquefied natural gas passed through the Strait of Hormuz.",
          "kind": "background",
          "outlet": "DW World",
          "url": "https://www.dw.com/en/donald-trump-to-declare-hormuz-us-territory-soon/a-78377755?maca=en-rss-en-world-4025-rdf",
          "source_kind": "fulltext"
        },
        {
          "id": 5,
          "cluster_id": 0,
          "text": "Donald Trump told rally attendees that no ships pass through the US blockade of the Strait of Hormuz unless the United States wants them to.",
          "kind": "quote",
          "outlet": "DW World",
          "url": "https://www.dw.com/en/donald-trump-to-declare-hormuz-us-territory-soon/a-78377755?maca=en-rss-en-world-4025-rdf",
          "source_kind": "fulltext"
        },
        {
          "id": 6,
          "cluster_id": 0,
          "text": "Two oil tankers operated by Abu Dhabi's state-owned oil company ADNOC were attacked by drones in the Strait of Hormuz.",
          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/us/pretty-soon-trump-vows-to-claim-hormuz-as-us-territory-iran-hits-back/articleshow/133251741.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 7,
          "cluster_id": 0,
          "text": "The United Arab Emirates accused Iran of piracy following drone attacks on two ADNOC tankers in the Strait of Hormuz.",
          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/us/pretty-soon-trump-vows-to-claim-hormuz-as-us-territory-iran-hits-back/articleshow/133251741.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 8,
          "cluster_id": 0,
          "text": "In June, the United States and Iran signed a memorandum of understanding to halt military operations during the war.",
          "kind": "background",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/news/2026/8/14/trump-says-he-will-declare-strait-of-hormuz-a-us-territory?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 9,
          "cluster_id": 0,
          "text": "A Quinnipiac University poll from late July found that 60 percent of US voters oppose US military action against Iran.",
          "kind": "figure",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/news/2026/8/14/trump-says-he-will-declare-strait-of-hormuz-a-us-territory?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 10,
          "cluster_id": 0,
          "text": "Iranian officials stated that Tehran will not reopen the Strait of Hormuz unless the US lifts sanctions, compensates for war damage, and releases frozen assets.",
          "kind": "background",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/us-news/2026/aug/14/trump-threat-strait-hormuz-us-territory",
          "source_kind": "fulltext"
        }
      ]
    },
