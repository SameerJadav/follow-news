      "claims": [
        {
          "id": 1,
          "cluster_id": 0,
          "text": "Thousands of US military members have lived aboard the aircraft carrier USS Abraham Lincoln for more than 250 days.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cyvl2d5j52lo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 2,
          "cluster_id": 0,
          "text": "Lawmakers are demanding answers from the Pentagon over reported food shortages, broken plumbing, and exhaustion aboard the USS Abraham Lincoln.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cyvl2d5j52lo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 3,
          "cluster_id": 0,
          "text": "Military news outlets reported that some sailors aboard the USS Abraham Lincoln have attempted to jump overboard.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cyvl2d5j52lo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 4,
          "cluster_id": 0,
          "text": "US Defence Secretary Pete Hegseth called reports of poor conditions aboard the USS Abraham Lincoln 'completely misrepresented'.",
