    {
      "cluster_id": 3,
      "headline_hint": "Trump puts on hold law allowing 100% tariffs on India and others over Russian oil purchases",
      "section": "india",
      "batch_position": 0,
      "claim_count": 14,
      "distinct_outlets": 5,
      "source_kinds": {
        "fulltext": 14
      },
      "claims": [
        {
          "id": 38,
          "cluster_id": 3,
          "text": "US Secretary of State Marco Rubio defended President Donald Trump's decision to grant a 60-day waiver from Russia-linked sanctions.",
          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/us/on-eve-of-visit-rubio-cites-indiato-defend-russia-sanction-pause/articleshow/135036999.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 39,
          "cluster_id": 3,
          "text": "Marco Rubio stated that India has voluntarily diversified its energy portfolio but still depends substantially on Russian energy.",
          "kind": "background",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/us/on-eve-of-visit-rubio-cites-indiato-defend-russia-sanction-pause/articleshow/135036999.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 40,
          "cluster_id": 3,
          "text": "President Donald Trump invoked Section 115 of the Graham Act to certify that waiving sanctions was in the US national interest.",
          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/us/on-eve-of-visit-rubio-cites-indiato-defend-russia-sanction-pause/articleshow/135036999.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 41,
          "cluster_id": 3,
          "text": "The waived Graham Act duties included tariffs of up to 500% on Russian goods and up to 100% on the five largest importers of Russian crude oil.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/us/on-eve-of-visit-rubio-cites-indiato-defend-russia-sanction-pause/articleshow/135036999.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 42,
          "cluster_id": 3,
          "text": "Donald Trump blocked several Russian sanctions on Friday night, two days before they were scheduled to take effect.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c9p8gz7zx4peo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 43,
          "cluster_id": 3,
          "text": "Ukrainian President Volodymyr Zelensky told NBC News that siding with Russian President Vladimir Putin would be a historic mistake.",
          "kind": "quote",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c9p8gz7zx4peo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 44,
          "cluster_id": 3,
          "text": "Russian envoy Kirill Dmitriev called Donald Trump's sanction waiver order an important and truly historic moment.",
          "kind": "quote",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c9p8gz7zx4peo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 45,
          "cluster_id": 3,
          "text": "According to the Centre for Research on Energy and Clean Air, China receives about 50% of Russia's crude exports, while India accounts for about 37%.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c9p8gz7zx4peo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 46,
          "cluster_id": 3,
          "text": "Donald Trump stated on Truth Social that his decision on Russia was simple and aimed at avoiding driving Russia away from peace negotiations.",
          "kind": "quote",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/europe/20261018-ukraine-zelensky-war-trump-peace-russia-sanctions",
          "source_kind": "fulltext"
        },
        {
          "id": 47,
          "cluster_id": 3,
          "text": "Donald Trump temporarily waived sanctions on Russian diesel to allow fuel into global markets and lower prices ahead of US elections.",
          "kind": "event",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/europe/20261018-ukraine-zelensky-war-trump-peace-russia-sanctions",
          "source_kind": "fulltext"
        },
        {
          "id": 48,
          "cluster_id": 3,
          "text": "Ukrainian President Volodymyr Zelensky stated he was thankful that the United States resumed intelligence sharing after a brief pause.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/ukraine-zelenskyy-nbc-us-unblocked-intelligence-sharing-6470361",
          "source_kind": "fulltext"
        },
        {
          "id": 49,
          "cluster_id": 3,
          "text": "US Treasury Secretary Scott Bessent called President Zelensky very reckless for alleging that the US government throttled SpaceX Starlink speeds.",
          "kind": "quote",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/ukraine-zelenskyy-nbc-us-unblocked-intelligence-sharing-6470361",
          "source_kind": "fulltext"
        },
        {
          "id": 50,
          "cluster_id": 3,
          "text": "The US Treasury authorized a deal on October 9 for Russia to supply more than 300,000 metric tonnes of diesel to global markets.",
          "kind": "figure",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/news/2026/10/18/russias-war-on-ukraine-must-be-brought-to-an-end-zelenskyy-says?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 51,
          "cluster_id": 3,
          "text": "US Energy Secretary Chris Wright stated that the Russian diesel arrangement was a carrot to try to end the war rather than an economic lifeline.",
          "kind": "quote",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/news/2026/10/18/russias-war-on-ukraine-must-be-brought-to-an-end-zelenskyy-says?traffic_source=rss",
          "source_kind": "fulltext"
        }
      ]
    },
    {
