      "claims": [
        {
          "id": 27,
          "cluster_id": 2,
          "text": "Masked Israeli settlers attacked a delegation of Belgian, French, and Polish diplomats, a French mayor, and Palestinian civilians near Taybeh on Saturday.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/us-officials-visit-palestinian-village-after-settler-attacks-diplomats-6469796",
          "source_kind": "fulltext"
        },
        {
          "id": 28,
          "cluster_id": 2,
          "text": "Washington Post photojournalist Heidi Levine was hospitalized after being assaulted on Friday while covering a Palestinian olive harvest in the West Bank.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/us-officials-visit-palestinian-village-after-settler-attacks-diplomats-6469796",
          "source_kind": "fulltext"
        },
        {
          "id": 29,
          "cluster_id": 2,
          "text": "US diplomats, including Assistant Secretary of State Riley Barnes and US Ambassador to the Holy See Brian Burch, visited the Christian Palestinian village of Taybeh on Sunday.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/us-officials-visit-palestinian-village-after-settler-attacks-diplomats-6469796",
          "source_kind": "fulltext"
        },
        {
          "id": 30,
          "cluster_id": 2,
          "text": "US Ambassador to Israel Mike Huckabee attended a settler conference in the West Bank on Sunday after publicly calling for those who attacked Heidi Levine to be jailed.",
          "kind": "background",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/us-officials-visit-palestinian-village-after-settler-attacks-diplomats-6469796",
          "source_kind": "fulltext"
        },
        {
          "id": 31,
          "cluster_id": 2,
          "text": "Israeli Foreign Minister Gideon Saar and the Israeli military blamed \"Israeli rioters\" for Saturday's attack on the diplomats.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/us-officials-visit-palestinian-village-after-settler-attacks-diplomats-6469796",
          "source_kind": "fulltext"
        },
        {
          "id": 32,
          "cluster_id": 2,
          "text": "Israeli human rights group Yesh Din recorded at least 170 settler attacks on Palestinians since September 27.",
          "kind": "background",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/us-officials-visit-palestinian-village-after-settler-attacks-diplomats-6469796",
          "source_kind": "fulltext"
        },
        {
          "id": 33,
          "cluster_id": 2,
          "text": "The office of Israeli Prime Minister Benjamin Netanyahu issued a social media statement titled \"Serious accusations require serious evidence\" casting doubt on the accounts of the attack on diplomats.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/oct/18/guardian-reporter-filmed-masked-militants-seconds-before-west-bank-attack-on-french-mayor",
          "source_kind": "fulltext"
        },
        {
          "id": 34,
          "cluster_id": 2,
          "text": "Eyewitnesses reported that an attacker aggressively shouted \"France, France\" before pushing French Mayor Bernard Baudoux to the ground during Saturday's attack.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/oct/18/guardian-reporter-filmed-masked-militants-seconds-before-west-bank-attack-on-french-mayor",
          "source_kind": "fulltext"
        },
        {
          "id": 35,
          "cluster_id": 2,
          "text": "Settlers smashed a reinforced window of an SUV carrying European diplomats as the vehicle drove away.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/oct/18/guardian-reporter-filmed-masked-militants-seconds-before-west-bank-attack-on-french-mayor",
          "source_kind": "fulltext"
        },
        {
          "id": 36,
          "cluster_id": 2,
          "text": "US Secretary of State Marco Rubio warned against a brewing \"crisis\" in the West Bank following recent settler attacks.",
          "kind": "event",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/video/20261018-israeli-settlers-attack-european-diplomats-beat-french-mayor",
          "source_kind": "fulltext"
        },
        {
          "id": 37,
          "cluster_id": 2,
          "text": "The West Bank is home to around 500,000 Israeli settlers and at least 3 million Palestinians.",
          "kind": "background",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/middle-east/us-officials-visit-palestinian-christian-town-after-settler-attacks-on-foreign-diplomats/articleshow/135031384.cms",
          "source_kind": "fulltext"
        }
      ]
