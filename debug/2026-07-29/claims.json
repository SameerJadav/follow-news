      },
      "claims": [
        {
          "id": 1,
          "cluster_id": 0,
          "text": "A 7.1-magnitude earthquake struck Kumamoto, Japan, causing widespread damage, injuries, and structural collapses.",
          "kind": "event",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/video/newsfeed/2026/7/28/aje-onl-nf_many-feared-dead-from-7-280726?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 2,
          "cluster_id": 0,
          "text": "A shopping mall collapsed and the outer walls of Kumamoto Castle were damaged during the earthquake.",
          "kind": "event",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/video/newsfeed/2026/7/28/aje-onl-nf_many-feared-dead-from-7-280726?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 3,
          "cluster_id": 0,
          "text": "Japanese Prime Minister Sanae Takaichi pledged a full government response to the earthquake.",
          "kind": "event",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/video/newsfeed/2026/7/28/aje-onl-nf_many-feared-dead-from-7-280726?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 4,
          "cluster_id": 0,
          "text": "An earthquake with a preliminary magnitude of 6.8 struck Kumamoto prefecture on southern Kyushu island, Japan, late Tuesday afternoon.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/jul/28/people-trapped-japan-earthquake-kumamoto-aeon-shopping-centre-mall-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 5,
          "cluster_id": 0,
          "text": "The US Geological Survey initially estimated the Kumamoto earthquake magnitude at 7.1 before revising it to 6.8.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/jul/28/people-trapped-japan-earthquake-kumamoto-aeon-shopping-centre-mall-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 6,
          "cluster_id": 0,
          "text": "Japanese Prime Minister Sanae Takaichi stated: \"Power outages and fires have occurred in some areas, and there has also been damage to roads and bridges and the collapse of buildings.\"",
          "kind": "quote",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/jul/28/people-trapped-japan-earthquake-kumamoto-aeon-shopping-centre-mall-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 7,
          "cluster_id": 0,
          "text": "An explosion occurred inside an Aeon shopping mall in Kumamoto shortly after the earthquake, trapping people inside.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/jul/28/people-trapped-japan-earthquake-kumamoto-aeon-shopping-centre-mall-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 8,
          "cluster_id": 0,
          "text": "The disaster management agency instructed approximately 300,000 people to move to evacuation centres following the earthquake.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/jul/28/people-trapped-japan-earthquake-kumamoto-aeon-shopping-centre-mall-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 9,
          "cluster_id": 0,
          "text": "The Japan Meteorological Agency reported over 60 aftershocks ranging in magnitude from 1 to 4 following the main tremor.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/jul/28/people-trapped-japan-earthquake-kumamoto-aeon-shopping-centre-mall-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 10,
          "cluster_id": 0,
          "text": "A tsunami warning issued immediately after the earthquake was lifted within two hours.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/jul/28/people-trapped-japan-earthquake-kumamoto-aeon-shopping-centre-mall-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 11,
          "cluster_id": 0,
          "text": "A series of powerful earthquakes in Kumamoto in 2016 killed 277 people either directly or from disaster-related injuries.",
          "kind": "background",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/jul/28/people-trapped-japan-earthquake-kumamoto-aeon-shopping-centre-mall-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 12,
          "cluster_id": 0,
          "text": "Over 40,000 households in Kumamoto Prefecture were experiencing power outages as of 01:30am local time.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/jul/28/people-trapped-japan-earthquake-kumamoto-aeon-shopping-centre-mall-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 13,
          "cluster_id": 0,
          "text": "The Aeon mall in Kumamoto had reopened on June 13, 2026, following extensive rebuilding after the 2016 earthquake.",
          "kind": "background",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/aeon-mall-japan-earthquake-reopened-destroyed-6284021",
          "source_kind": "fulltext"
        },
        {
          "id": 14,
          "cluster_id": 0,
          "text": "Mall staff helped evacuate about 200 visitors outside before an explosion destroyed the walls and structure of the Aeon mall.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/aeon-mall-japan-earthquake-reopened-destroyed-6284021",
          "source_kind": "fulltext"
        },
        {
          "id": 15,
          "cluster_id": 0,
          "text": "The earthquake struck Kumamoto prefecture on Kyushu island at 16:27 local time (07:27 GMT) on Tuesday.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cgewgxlpj3po?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 16,
          "cluster_id": 0,
          "text": "Two workers were found in cardiac arrest and nine others were reported missing after a chimney collapsed at Nippon Paper's Yatsushiro Plant.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cgewgxlpj3po?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        }
      ]
