          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/middle-east/arab-parties-claim-kingmaker-status-in-israel/articleshow/135283765.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 17,
          "cluster_id": 0,
          "text": "Arab citizens of Israel comprise approximately 20% of the population, or roughly 2.1 million people.",
          "kind": "background",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/middle-east/arab-parties-claim-kingmaker-status-in-israel/articleshow/135283765.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 18,
          "cluster_id": 0,
          "text": "Voter turnout in the Israeli election on October 27 was the highest recorded since 1999.",
          "kind": "figure",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/commentary/israel-election-results-benjamin-netanyahu-divided-6499566",
          "source_kind": "fulltext"
