      "distinct_outlets": 5,
      "source_kinds": {
        "fulltext": 19
      },
      "claims": [
        {
          "id": 1,
          "cluster_id": 0,
          "text": "With nearly 90 percent of the votes counted by Wednesday evening, neither Benjamin Netanyahu nor opposition leader Gadi Eisenkot appeared to have enough seats to form a government on his own.",
          "kind": "event",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/world/israeli-elections-votes-nearly-counted-neither-netanyahu-nor-eisenkot-are-likely-to-get-majority-latest-update-11793235026445.html",
          "source_kind": "fulltext"
        },
        {
          "id": 2,
          "cluster_id": 0,
          "text": "A majority in the 120-seat Knesset requires 61 seats.",
          "kind": "background",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/world/israeli-elections-votes-nearly-counted-neither-netanyahu-nor-eisenkot-are-likely-to-get-majority-latest-update-11793235026445.html",
          "source_kind": "fulltext"
        },
        {
          "id": 3,
          "cluster_id": 0,
          "text": "Early results put Benjamin Netanyahu's coalition bloc at about 53 to 54 seats and Gadi Eisenkot's bloc at around 49 seats.",
          "kind": "figure",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/world/israeli-elections-votes-nearly-counted-neither-netanyahu-nor-eisenkot-are-likely-to-get-majority-latest-update-11793235026445.html",
          "source_kind": "fulltext"
        },
        {
          "id": 4,
          "cluster_id": 0,
          "text": "Benjamin Netanyahu's Likud party remains the largest single party in parliament, with an estimated 26 seats.",
          "kind": "figure",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/world/israeli-elections-votes-nearly-counted-neither-netanyahu-nor-eisenkot-are-likely-to-get-majority-latest-update-11793235026445.html",
          "source_kind": "fulltext"
        },
        {
          "id": 5,
          "cluster_id": 0,
          "text": "Arab citizens of Israel turned out to vote in record numbers during the election.",
          "kind": "event",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/world/israeli-elections-votes-nearly-counted-neither-netanyahu-nor-eisenkot-are-likely-to-get-majority-latest-update-11793235026445.html",
          "source_kind": "fulltext"
        },
        {
          "id": 6,
          "cluster_id": 0,
          "text": "Gadi Eisenkot stated he wants an Israeli government that is Zionist and committed to universal military conscription.",
          "kind": "event",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/world/israeli-elections-votes-nearly-counted-neither-netanyahu-nor-eisenkot-are-likely-to-get-majority-latest-update-11793235026445.html",
          "source_kind": "fulltext"
        },
        {
          "id": 7,
          "cluster_id": 0,
          "text": "The Israeli Knesset is scheduled to open on November 10.",
          "kind": "background",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/world/israeli-elections-votes-nearly-counted-neither-netanyahu-nor-eisenkot-are-likely-to-get-majority-latest-update-11793235026445.html",
          "source_kind": "fulltext"
        },
        {
          "id": 8,
          "cluster_id": 0,
          "text": "Israelis rallied in Tel Aviv demanding a Jewish-Arab government after Arab parties made major gains in Tuesday's election.",
          "kind": "event",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/video/newsfeed/2026/10/29/israelis-rally-for-jewish-arab-government-after-election-gains?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 9,
          "cluster_id": 0,
          "text": "The two main Arab parties in Israel are projected to win around 19 of the Knesset's 120 seats.",
          "kind": "figure",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/video/newsfeed/2026/10/29/israelis-rally-for-jewish-arab-government-after-election-gains?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 10,
          "cluster_id": 0,
          "text": "Yair Golan, leader of the centre-left Democrats party, called for forming a change government in partnership with Arab citizens of Israel.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/oct/28/israel-election-results-live-updates-exit-polls-netanyahu-likud-eisenkot-latest-news",
          "source_kind": "fulltext"
        },
        {
          "id": 11,
          "cluster_id": 0,
          "text": "Israel's Central Elections Committee received a complaint from the Likud party alleging that Arab parties compromised election integrity.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/oct/28/israel-election-results-live-updates-exit-polls-netanyahu-likud-eisenkot-latest-news",
          "source_kind": "fulltext"
        },
        {
          "id": 12,
          "cluster_id": 0,
          "text": "UN rights chief Volker Turk said he hopes the next Israeli government will change course massively and respect international law.",
          "kind": "quote",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/oct/28/israel-election-results-live-updates-exit-polls-netanyahu-likud-eisenkot-latest-news",
          "source_kind": "fulltext"
        },
        {
          "id": 13,
          "cluster_id": 0,
          "text": "The two main Arab political parties in Israel are the Yousef Jabareen-led Joint List and Ra'am, led by Mansour Abbas.",
          "kind": "background",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/middle-east/arab-parties-claim-kingmaker-status-in-israel/articleshow/135283765.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 14,
          "cluster_id": 0,
          "text": "Yousef Jabareen stated the Joint List would seek to use its projected 12 seats to facilitate removing Benjamin Netanyahu's government.",
          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/middle-east/arab-parties-claim-kingmaker-status-in-israel/articleshow/135283765.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 15,
          "cluster_id": 0,
          "text": "Ra'am leader Mansour Abbas stated that senior members of Gadi Eisenkot's bloc had discussed a potential coalition deal with him prior to the election.",
          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/middle-east/arab-parties-claim-kingmaker-status-in-israel/articleshow/135283765.cms",
          "source_kind": "fulltext"
        },
        {
