      },
      "claims": [
        {
          "id": 47,
          "cluster_id": 4,
          "text": "Two new eruptions were recorded as Indonesia's Anak Krakatau continued to spew volcanic ash, disrupting hundreds of flights across six airports.",
          "kind": "event",
          "outlet": "Al Jazeera",
