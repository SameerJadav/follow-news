      "headline_hint": "Moroccan security forces intercept over 100 migrants attempting to enter Spain's Ceuta enclave",
      "section": "world",
      "claim_count": 8,
      "distinct_outlets": 4,
      "source_kinds": {
        "fulltext": 8
      },
      "claims": [
        {
          "id": 42,
          "cluster_id": 4,
          "text": "Moroccan security forces detained 111 migrants near the town of Fnideq while preventing a mass attempt to cross into the Spanish exclave of Ceuta.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/ckg44x2ey1ro?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 43,
          "cluster_id": 4,
          "text": "Moroccan police used tear gas to disperse groups of migrants gathered on hills near the border.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/ckg44x2ey1ro?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 44,
          "cluster_id": 4,
          "text": "Italy suspended Schengen free-movement arrangements with Spain and introduced border checks after a major migration surge into Ceuta in late July.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/ckg44x2ey1ro?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 45,
          "cluster_id": 4,
          "text": "More than 72,000 migrants crossed into Ceuta during a major influx on July 30, resulting in at least 96 deaths.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/aug/15/moroccan-police-arrest-more-than-100-people-as-they-attempt-to-enter-ceuta",
          "source_kind": "fulltext"
        },
        {
          "id": 46,
          "cluster_id": 4,
          "text": "Spain deployed over 500 additional police officers to Ceuta, bringing the total security presence in the exclave to more than 1,600 personnel.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/aug/15/moroccan-police-arrest-more-than-100-people-as-they-attempt-to-enter-ceuta",
          "source_kind": "fulltext"
        },
        {
          "id": 47,
          "cluster_id": 4,
          "text": "Spanish Interior Minister Fernando Grande-Marlaska stated that around 5,000 migrants remained in Ceuta.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/aug/15/moroccan-police-arrest-more-than-100-people-as-they-attempt-to-enter-ceuta",
          "source_kind": "fulltext"
        },
        {
          "id": 48,
          "cluster_id": 4,
          "text": "False posts on social media claiming the border would open for the Assumption holiday spurred migrants to gather near the Ceuta border.",
          "kind": "event",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/ceuta-false-social-media-posts-fuel-migration-tensions",
          "source_kind": "fulltext"
        },
        {
          "id": 49,
          "cluster_id": 4,
          "text": "Moroccan news portal Le360 reported that up to 294 people, including 46 Moroccans, were arrested during Saturday's border security operation.",
          "kind": "figure",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/news/2026/8/15/moroccan-police-arrest-over-100-migrants-trying-to-reach-spanish-enclave?traffic_source=rss",
          "source_kind": "fulltext"
        }
      ]
    },
