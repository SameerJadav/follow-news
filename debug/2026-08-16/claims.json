      "source_kinds": {
        "fulltext": 11
      },
      "claims": [
        {
          "id": 14,
          "cluster_id": 1,
          "text": "A 7.7-magnitude earthquake struck off the island of Flores in eastern Indonesia shortly before 05:00 local time on Saturday at a depth of 15km.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c3v00w5ylw9o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 15,
          "cluster_id": 1,
          "text": "At least 47 people were reported killed across several provinces in eastern Indonesia following the earthquake.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c3v00w5ylw9o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 16,
          "cluster_id": 1,
          "text": "Authorities lifted an initial tsunami warning approximately three hours after the quake when no significant sea level rise was detected.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c3v00w5ylw9o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 17,
          "cluster_id": 1,
          "text": "The 7.7-magnitude earthquake off Flores was followed by more than 230 aftershocks, including a major tremor measuring 6.1.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/rest-of-world/indonesia-rocked-by-3-major-quakes-and-more-than-230-aftershocks-in-24-hours/articleshow/133266309.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 18,
          "cluster_id": 1,
          "text": "A separate 6.9-magnitude earthquake struck Sumatra at a depth of 172km within the same 24-hour period.",
          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/rest-of-world/indonesia-rocked-by-3-major-quakes-and-more-than-230-aftershocks-in-24-hours/articleshow/133266309.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 19,
          "cluster_id": 1,
          "text": "Rescue officials in the port town of Maumere found 20 people dead, six severely injured, and two trapped under rubble following building collapses and landslides.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/aug/15/indonesia-earthquake",
          "source_kind": "fulltext"
        },
        {
          "id": 20,
          "cluster_id": 1,
          "text": "Landslides in Ende regency severed the Trans-Flores highway, a 435-mile mountain road.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/aug/15/indonesia-earthquake",
          "source_kind": "fulltext"
        },
        {
          "id": 21,
          "cluster_id": 1,
          "text": "The United States Geological Survey placed the epicentre of the 7.7-magnitude quake 68 kilometres northwest of the city of Ende at a depth of 10 kilometres.",
          "kind": "figure",
          "outlet": "Scroll.in",
          "url": "https://scroll.in/latest/1095057/indonesia-at-least-38-dead-as-7-7-magnitude-earthquake-strikes-eastern-coast?utm_source=rss&utm_medium=public",
          "source_kind": "fulltext"
        },
        {
          "id": 22,
          "cluster_id": 1,
          "text": "Sixteen bodies were recovered from a landslide site in the village of Reok in the Manggarai region.",
          "kind": "figure",
          "outlet": "Scroll.in",
          "url": "https://scroll.in/latest/1095057/indonesia-at-least-38-dead-as-7-7-magnitude-earthquake-strikes-eastern-coast?utm_source=rss&utm_medium=public",
          "source_kind": "fulltext"
        },
        {
          "id": 23,
          "cluster_id": 1,
          "text": "The Indonesian government dispatched 50,000 aid packages weighing a total of 275 tonnes to the disaster region.",
          "kind": "figure",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/asia/indonesia-earthquake-flores-island-death-toll-6321396",
          "source_kind": "fulltext"
        },
        {
          "id": 24,
          "cluster_id": 1,
          "text": "European Union chief Ursula von der Leyen offered help from the EU's Copernicus Earth observation satellites to support search and rescue efforts.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/asia/indonesia-earthquake-flores-island-death-toll-6321396",
          "source_kind": "fulltext"
        }
      ]
    },
