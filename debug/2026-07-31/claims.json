    {
      "cluster_id": 1,
      "headline_hint": "UEFA threatens full World Cup boycott over FIFA private investment plans",
      "section": "world",
      "claim_count": 9,
      "distinct_outlets": 5,
      "source_kinds": {
        "summary": 1,
        "fulltext": 8
      },
      "claims": [
        {
          "id": 12,
          "cluster_id": 1,
          "text": "FIFA's proposed new commercial subsidiary would be valued at around $20 billion, with Thrive Eternal expected to lead the proposed investor group.",
          "kind": "figure",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/sport/fifa-stake-sale-push-tests-footballs-american-century-bennett-says-6289556",
          "source_kind": "fulltext"
        },
        {
          "id": 13,
          "cluster_id": 1,
          "text": "European football's governing body UEFA stated on Thursday that it would boycott the World Cup if FIFA presses ahead with its private investor plan.",
          "kind": "event",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/uefa-says-will-boycott-world-cup-if-fifa-pushes-private-investor-proposal",
          "source_kind": "summary"
        },
        {
          "id": 14,
          "cluster_id": 1,
          "text": "The 2030 FIFA World Cup is scheduled to be staged primarily in Spain, Portugal, and Morocco, with centenary matches in Uruguay, Argentina, and Paraguay.",
          "kind": "background",
          "outlet": "NPR World",
          "url": "https://www.npr.org/2026/07/30/nx-s1-5913664/world-cup-fifa-uefa-gianni-infantino",
          "source_kind": "fulltext"
        },
        {
          "id": 15,
          "cluster_id": 1,
          "text": "Concacaf expressed deep concerns regarding the lack of due process in FIFA's proposal, though it stopped short of calling for a boycott.",
          "kind": "event",
          "outlet": "NPR World",
          "url": "https://www.npr.org/2026/07/30/nx-s1-5913664/world-cup-fifa-uefa-gianni-infantino",
          "source_kind": "fulltext"
        },
        {
          "id": 16,
          "cluster_id": 1,
          "text": "FIFA President Gianni Infantino offered member associations an increase in basic funding from $10 million to $20 million over four years if the investment proposal is approved.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/sports/football/top-stories/uefa-threatens-fifa-world-cup-boycott-over-gianni-infantinos-private-investors-plan/articleshow/132745748.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 17,
          "cluster_id": 1,
          "text": "Under FIFA's proposal, private investors would own a 20 percent stake in the newly proposed commercial company, FIFA Forward Enterprise.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/sports/football/top-stories/uefa-threatens-fifa-world-cup-boycott-over-gianni-infantinos-private-investors-plan/articleshow/132745748.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 18,
          "cluster_id": 1,
          "text": "The Women's Under-20 World Cup in Poland is scheduled to begin on September 5.",
          "kind": "background",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/sports/football/top-stories/uefa-threatens-fifa-world-cup-boycott-over-gianni-infantinos-private-investors-plan/articleshow/132745748.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 19,
          "cluster_id": 1,
          "text": "FIFA seeks to raise up to $4.2 billion from private investors through its proposed FIFA Forward Enterprise entity.",
          "kind": "figure",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/trends/no-european-team-in-football-world-cup-president-gianni-infantino-softens-stance-as-uefa-mulls-boycotting-fifa-events-11785431498442.html",
          "source_kind": "fulltext"
        },
        {
          "id": 20,
          "cluster_id": 1,
          "text": "Gianni Infantino defended the proposal by stating that FIFA Forward Enterprise is an offer, part of a democratic process, and an opportunity rather than an obligation.",
          "kind": "quote",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/trends/no-european-team-in-football-world-cup-president-gianni-infantino-softens-stance-as-uefa-mulls-boycotting-fifa-events-11785431498442.html",
          "source_kind": "fulltext"
        }
      ]
    },
