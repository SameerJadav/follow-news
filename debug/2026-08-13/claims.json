      },
      "claims": [
        {
          "id": 1,
          "cluster_id": 0,
          "text": "A partial solar eclipse was witnessed across parts of Africa on August 12, 2026.",
          "kind": "event",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/partial-eclipse-seen-from-north-and-west-africa",
          "source_kind": "fulltext"
        },
        {
          "id": 2,
          "cluster_id": 0,
          "text": "The next total solar eclipse visible from the UK, France, and mainland Europe will take place in September 2081.",
          "kind": "background",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/aug/12/europe-solar-eclipse-spain-uk-iceland-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 3,
          "cluster_id": 0,
          "text": "European Space Agency reserve astronaut Sara García Alonso told RTVE that the eclipse was one of the most beautiful things she had ever seen and gave her goosebumps.",
          "kind": "quote",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/aug/12/europe-solar-eclipse-spain-uk-iceland-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 4,
          "cluster_id": 0,
          "text": "Astronaut Pablo Álvarez Fernández stated that the eclipse was much more beautiful than he had expected.",
          "kind": "quote",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/live/2026/aug/12/europe-solar-eclipse-spain-uk-iceland-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 5,
          "cluster_id": 0,
          "text": "Thousands of people gathered across Spain, Iceland, and other European countries on August 12, 2026, to watch a total solar eclipse.",
          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/europe/magical-eeriness-spain-iceland-witness-spectacular-total-solar-eclipse-watch/articleshow/133192900.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 6,
          "cluster_id": 0,
          "text": "The total solar eclipse was Spain's first in more than a century.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/europe/magical-eeriness-spain-iceland-witness-spectacular-total-solar-eclipse-watch/articleshow/133192900.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 7,
          "cluster_id": 0,
          "text": "Spanish authorities expected at least 500,000 additional visitors for the solar eclipse.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/europe/magical-eeriness-spain-iceland-witness-spectacular-total-solar-eclipse-watch/articleshow/133192900.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 8,
          "cluster_id": 0,
          "text": "Spain deployed more than 33,500 law enforcement officers around eclipse viewing areas and access points.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/europe/magical-eeriness-spain-iceland-witness-spectacular-total-solar-eclipse-watch/articleshow/133192900.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 9,
          "cluster_id": 0,
          "text": "Iceland experienced its first total solar eclipse since 1954, which was visible from Reykjavík for the first time since 1433.",
          "kind": "background",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/europe/magical-eeriness-spain-iceland-witness-spectacular-total-solar-eclipse-watch/articleshow/133192900.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 10,
          "cluster_id": 0,
          "text": "The total solar eclipse started at 15:34 GMT on August 12, 2026, with totality lasting about two minutes.",
          "kind": "figure",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/gallery/2026/8/12/photos-solar-eclipse-plunges-parts-of-europe-into-darkness?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 11,
          "cluster_id": 0,
          "text": "The path of totality brought near-total darkness to approximately 15 million people across northern Russia, Greenland, Iceland, Spain, and part of Portugal.",
          "kind": "figure",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/gallery/2026/8/12/photos-solar-eclipse-plunges-parts-of-europe-into-darkness?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 12,
          "cluster_id": 0,
          "text": "The solar eclipse was the first total eclipse visible in mainland Europe since 2006.",
          "kind": "figure",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/solar-eclipse-spain-europe-arctic-6315731",
          "source_kind": "fulltext"
        },
        {
          "id": 13,
          "cluster_id": 0,
          "text": "The Spanish government estimated that 450,000 extra tourists visiting for the eclipse would provide a 347-million-euro ($400 million) economic boost.",
          "kind": "figure",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/solar-eclipse-spain-europe-arctic-6315731",
          "source_kind": "fulltext"
        },
        {
          "id": 14,
          "cluster_id": 0,
          "text": "Spanish Interior Minister Fernando Grande-Marlaska stated that nearly 25,000 police officers were mobilised for the eclipse.",
          "kind": "figure",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/solar-eclipse-spain-europe-arctic-6315731",
          "source_kind": "fulltext"
        },
        {
          "id": 15,
          "cluster_id": 0,
          "text": "Another total solar eclipse is expected to cross southern Spain and northern Africa in August 2027, followed by an annular eclipse over the Iberian Peninsula in 2028.",
          "kind": "background",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/solar-eclipse-spain-europe-arctic-6315731",
          "source_kind": "fulltext"
        }
      ]
    },
    {
      "cluster_id": 1,
      "headline_hint": "White House Press Secretary Karoline Leavitt to step down at end of month",
      "section": "world",
      "claim_count": 15,
      "distinct_outlets": 5,
      "source_kinds": {
        "fulltext": 15
      },
      "claims": [
        {
          "id": 16,
          "cluster_id": 1,
          "text": "White House Press Secretary Karoline Leavitt will step down from her position at the end of August 2026.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cvglzrvyrz3o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 17,
          "cluster_id": 1,
          "text": "President Donald Trump wrote in a social media post that Leavitt will become one of his top outside advisors and an influential voice within the Republican Party.",
          "kind": "quote",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cvglzrvyrz3o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 18,
          "cluster_id": 1,
          "text": "Karoline Leavitt, aged 28, became the youngest person to ever serve as White House Press Secretary when she took the role.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cvglzrvyrz3o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 19,
          "cluster_id": 1,
          "text": "Leavitt gave birth to her second child, a daughter named Viviana, with husband Nicholas Riccio in May 2026.",
          "kind": "background",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cvglzrvyrz3o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 20,
          "cluster_id": 1,
          "text": "In 2022, Leavitt won a Republican primary but lost the general election for a New Hampshire Congressional seat to Democrat Chris Pappas.",
          "kind": "background",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cvglzrvyrz3o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 21,
          "cluster_id": 1,
          "text": "In February 2025, Leavitt's office seized control of the White House press pool from the White House Correspondents' Association.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cvglzrvyrz3o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 22,
          "cluster_id": 1,
          "text": "President Trump signed a national security presidential memorandum on August 12, 2026, to empower federal law enforcement to use cyber tools against transnational criminal organizations.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/us-news/live/2026/aug/12/donald-trump-air-force-one-switch-politics-primaries-midterm-elections-results-latest-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 23,
          "cluster_id": 1,
          "text": "During a briefing on January 28, 2025, Leavitt incorrectly claimed that DOGE and OMB found $50 million in federal funds slated for condoms in Gaza.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/us-news/live/2026/aug/12/donald-trump-air-force-one-switch-politics-primaries-midterm-elections-results-latest-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 24,
          "cluster_id": 1,
          "text": "The Washington Post reported that Trump used a plane carrying cabinet officials, staff, and journalists as a decoy when leaving a NATO summit in Turkey in July 2026 due to an assassination threat.",
          "kind": "event",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/americas/20260812-white-house-press-secretary-and-trump-adviser-karoline-leavitt-to-leave-role",
          "source_kind": "fulltext"
        },
        {
          "id": 25,
          "cluster_id": 1,
          "text": "Leavitt delayed her maternity leave in May 2026 following an alleged assassination attempt on Donald Trump at the White House Correspondents' Dinner.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/leavitt-trump-white-house-press-step-down-6315956",
          "source_kind": "fulltext"
        },
        {
          "id": 26,
          "cluster_id": 1,
          "text": "Four senior female Cabinet-level officials—Kristi Noem, Pam Bondi, Lori Chavez-DeRemer, and Tulsi Gabbard—departed Trump's second administration by mid-2026.",
          "kind": "event",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/us-news/trumps-top-women-officials-noem-bondi-gabbard-chavez-deremer-leavitt-depart-controversies-and-reasons-11786567418094.html",
          "source_kind": "fulltext"
        },
        {
          "id": 27,
          "cluster_id": 1,
          "text": "Kristi Noem was fired as Secretary of Homeland Security on March 5, 2026, and was succeeded by Senator Markwayne Mullin.",
          "kind": "event",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/us-news/trumps-top-women-officials-noem-bondi-gabbard-chavez-deremer-leavitt-depart-controversies-and-reasons-11786567418094.html",
          "source_kind": "fulltext"
        },
        {
          "id": 28,
          "cluster_id": 1,
          "text": "Attorney General Pam Bondi was ousted in early April 2026 amid controversy over Jeffrey Epstein files and was replaced by Todd Blanche.",
          "kind": "event",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/us-news/trumps-top-women-officials-noem-bondi-gabbard-chavez-deremer-leavitt-depart-controversies-and-reasons-11786567418094.html",
          "source_kind": "fulltext"
        },
        {
          "id": 29,
          "cluster_id": 1,
          "text": "Labor Secretary Lori Chavez-DeRemer resigned on April 20, 2026, amid an internal fraud and misconduct investigation.",
          "kind": "event",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/us-news/trumps-top-women-officials-noem-bondi-gabbard-chavez-deremer-leavitt-depart-controversies-and-reasons-11786567418094.html",
          "source_kind": "fulltext"
        },
        {
          "id": 30,
          "cluster_id": 1,
          "text": "Tulsi Gabbard left her post as Director of National Intelligence effective June 30, 2026, and was replaced by Jay Clayton.",
          "kind": "event",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/us-news/trumps-top-women-officials-noem-bondi-gabbard-chavez-deremer-leavitt-depart-controversies-and-reasons-11786567418094.html",
          "source_kind": "fulltext"
        }
      ]
    },
