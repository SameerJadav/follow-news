      "claims": [
        {
          "id": 31,
          "cluster_id": 2,
          "text": "A 32-year-old woman named Daniela Largo was rescued alive in Pereira after being trapped under rubble for 36 hours following a 7.4-magnitude earthquake in Colombia.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cz7d2e5wlgno?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 32,
          "cluster_id": 2,
          "text": "Colombian President Abelardo de la Espriella stated that at least 265 people died and 496 remain missing following the earthquake.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cz7d2e5wlgno?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 33,
          "cluster_id": 2,
          "text": "According to Asocapitales, 79 people died in Pereira and 95 died in Cali following the earthquake.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cz7d2e5wlgno?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 34,
          "cluster_id": 2,
          "text": "At least 92 buildings collapsed in Pereira during the earthquake.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cz7d2e5wlgno?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 35,
          "cluster_id": 2,
          "text": "The 7.4-magnitude earthquake struck western Colombia at 07:34 local time (12:34 GMT) on August 10, 2026, with its epicenter near San José del Palmar in Chocó province.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cz7d2e5wlgno?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 36,
          "cluster_id": 2,
          "text": "Search and rescue operations continued in Colombia as thousands were reported missing after the earthquake.",
          "kind": "event",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/video/newsfeed/2026/8/12/thousands-missing-after-colombia-quake-as-rescue-continues?traffic_source=rss",
          "source_kind": "summary"
        },
        {
          "id": 37,
          "cluster_id": 2,
          "text": "More than 200 people were confirmed dead and over 2,000 reported missing 48 hours after the earthquake in Colombia.",
          "kind": "figure",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/colombia-bogota-s-search-for-survivors-continues",
          "source_kind": "fulltext"
        },
        {
          "id": 38,
          "cluster_id": 2,
          "text": "Colombian President Abelardo de la Espriella declared a state of emergency following the earthquake.",
          "kind": "event",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/colombia-bogota-s-search-for-survivors-continues",
          "source_kind": "fulltext"
        },
        {
          "id": 39,
          "cluster_id": 2,
          "text": "Daniela Largo was rescued from the ruins of a collapsed hotel in Pereira after spending 36 hours under debris.",
          "kind": "event",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/video/20260812-colombia-woman-rescued-from-under-earthquake-debris-after-36-hours",
          "source_kind": "fulltext"
        }
      ]
