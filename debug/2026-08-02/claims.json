          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cz7d17r455go?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 6,
          "cluster_id": 0,
          "text": "Spanish police began installing a 500-metre floating barrier off the border with Morocco to prevent illegal migration by water.",
