          "source_kind": "fulltext"
        },
        {
          "id": 13,
          "cluster_id": 0,
          "text": "To reach Ceuta by water, migrants often swim approximately five kilometres from the Moroccan town of Fnideq.",
          "kind": "background",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/news/2026/8/1/spain-says-migrants-leaving-ceuta-after-mass-influx-in-which-67-died?traffic_source=rss",
          "source_kind": "fulltext"
        }
      ]
