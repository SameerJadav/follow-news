        },
        {
          "id": 17,
          "cluster_id": 1,
          "text": "Serbian President Aleksandar Vucic did not attend Ratko Mladic's funeral, citing a scheduled meeting with the president of Uzbekistan.",
          "kind": "event",
          "outlet": "DW World",
          "url": "https://www.dw.com/en/war-criminal-ratko-mladic-buried-with-military-honors-in-belgrade-serbia/a-79148678?maca=en-rss-en-world-4025-rdf",
          "source_kind": "fulltext"
        },
        {
          "id": 18,
          "cluster_id": 1,
          "text": "EU Enlargement Commissioner Marta Kos canceled a planned visit to Belgrade following the military honors provided for Ratko Mladic's funeral.",
          "kind": "event",
          "outlet": "DW World",
          "url": "https://www.dw.com/en/war-criminal-ratko-mladic-buried-with-military-honors-in-belgrade-serbia/a-79148678?maca=en-rss-en-world-4025-rdf",
          "source_kind": "fulltext"
        },
        {
          "id": 19,
          "cluster_id": 1,
          "text": "A canopy collapse at the railway station in Novi Sad in November 2024 killed 16 people, triggering student-led protests in Serbia.",
          "kind": "figure",
          "outlet": "DW World",
          "url": "https://www.dw.com/en/war-criminal-ratko-mladic-buried-with-military-honors-in-belgrade-serbia/a-79148678?maca=en-rss-en-world-4025-rdf",
          "source_kind": "fulltext"
        },
        {
          "id": 20,
          "cluster_id": 1,
          "text": "Free bus services were organized from Bosnia and towns across Serbia for people attending Ratko Mladic's funeral.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cn5dkk7yw74o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 21,
          "cluster_id": 1,
          "text": "Fans of the Serbian football club Red Star Belgrade displayed an image of Ratko Mladic before their derby match against Partizan Belgrade.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cn5dkk7yw74o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        }
      ]
