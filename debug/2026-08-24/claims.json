      "claims": [
        {
          "id": 13,
          "cluster_id": 1,
          "text": "Ukrainian President Volodymyr Zelenskyy warned that holding elections during the war is a huge risk and would be a tsunami for the state that will split Ukraine.",
          "kind": "quote",
