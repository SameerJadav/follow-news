          "source_kind": "fulltext"
        },
        {
          "id": 14,
          "cluster_id": 1,
          "text": "Ukraine suspended national elections under martial law following Russia's full-scale invasion in 2022, and Volodymyr Zelenskyy's five-year presidential term formally expired in May 2024.",
          "kind": "background",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/europe/could-destroy-ukraine-zelenskyys-big-warning-as-calls-grow-for-fresh-elections-amid-ongoing-war/articleshow/133440362.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 15,
          "cluster_id": 1,
          "text": "Ousted former Ukrainian defence minister Mykhailo Fedorov publicly called for Ukraine to organize fresh elections despite the ongoing war.",
          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/europe/could-destroy-ukraine-zelenskyys-big-warning-as-calls-grow-for-fresh-elections-amid-ongoing-war/articleshow/133440362.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 16,
          "cluster_id": 1,
          "text": "Volodymyr Zelenskyy stated that Russia possesses a stockpile of between 600 and 630 high-speed ballistic missiles and seeks to produce over 100 a month.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/europe/could-destroy-ukraine-zelenskyys-big-warning-as-calls-grow-for-fresh-elections-amid-ongoing-war/articleshow/133440362.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 17,
          "cluster_id": 1,
          "text": "Former Ukrainian Defence Minister Mykhailo Fedorov stated in a BBC interview that Volodymyr Zelenskyy should face questions regarding his awareness of potential inner-circle corruption following a money laundering investigation.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cwy4ypzvd7po?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 18,
          "cluster_id": 1,
          "text": "Ukraine's anti-corruption bureau uncovered a scheme misappropriating more than $3 million in Ukrainian currency to pay bail for a former energy minister accused of money laundering.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cwy4ypzvd7po?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 19,
          "cluster_id": 1,
          "text": "Germany agreed to supply Ukraine with about 600 PAC-2 and PAC-3 interceptors in 2027 and 2028.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/aug/23/ukraine-election-wartime-risk-russia-zelenskyy",
          "source_kind": "fulltext"
        },
        {
          "id": 20,
          "cluster_id": 1,
          "text": "Volodymyr Zelenskyy stated he believes Russia will try to conscript an additional 300,000 soldiers following its parliamentary elections in September.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/aug/23/ukraine-election-wartime-risk-russia-zelenskyy",
          "source_kind": "fulltext"
        },
        {
          "id": 21,
          "cluster_id": 1,
          "text": "Norway announced plans to give 85 billion Norwegian crowns ($9.2 billion) in financial support to Ukraine in the 2027 fiscal year.",
          "kind": "figure",
          "outlet": "DW World",
          "url": "https://www.dw.com/en/ukraine-zelenskyy-rejects-wartime-elections/a-78475087?maca=en-rss-en-world-4025-rdf",
          "source_kind": "fulltext"
        }
      ]
