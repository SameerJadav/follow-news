      "headline_hint": "August recorded as joint-hottest month on record globally amid growing El Nino pattern",
      "section": "world",
      "batch_position": 3,
      "claim_count": 7,
      "distinct_outlets": 4,
      "source_kinds": {
        "fulltext": 7
      },
      "claims": [
        {
          "id": 33,
          "cluster_id": 3,
          "text": "The Copernicus Climate Change Service reported August 2026 was the joint-warmest month ever recorded globally, tying July 2023.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/india/global-climate-record-august-this-year-joint-warmest-month-with-july-23/articleshow/134033453.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 34,
          "cluster_id": 3,
          "text": "August 2026 was 1.65 degrees Celsius warmer than the estimated 1850-1900 pre-industrial baseline.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/india/global-climate-record-august-this-year-joint-warmest-month-with-july-23/articleshow/134033453.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 35,
          "cluster_id": 3,
          "text": "India recorded a mean monthly temperature of 28.01 degrees Celsius in August 2026, making it the country's warmest August since 1901.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/india/global-climate-record-august-this-year-joint-warmest-month-with-july-23/articleshow/134033453.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 36,
          "cluster_id": 3,
          "text": "Europe's climate monitor reported an unprecedented El Nino pattern is continuing to grow globally.",
          "kind": "background",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/video/20260910-august-hottest-month-ever-recorded-globally-as-huge-el-nino-emerges",
          "source_kind": "fulltext"
        },
        {
          "id": 37,
          "cluster_id": 3,
          "text": "Daily global extra-polar sea surface temperature reached a record high of 21.11 degrees Celsius on August 2026.",
          "kind": "figure",
          "outlet": "Hindustan Times",
          "url": "https://www.hindustantimes.com/india-news/august-joint-hottest-month-on-record-global-temperatures-again-above-1-5-c-c3s-says-101789039043097.html",
          "source_kind": "fulltext"
        },
        {
          "id": 38,
          "cluster_id": 3,
          "text": "Major European rivers including the Rhine, Danube, Southern Bug, and Dnieper experienced exceptionally low flows during August.",
          "kind": "background",
          "outlet": "Hindustan Times",
          "url": "https://www.hindustantimes.com/india-news/august-joint-hottest-month-on-record-global-temperatures-again-above-1-5-c-c3s-says-101789039043097.html",
          "source_kind": "fulltext"
        },
        {
          "id": 39,
          "cluster_id": 3,
          "text": "June through August 2026 in the contiguous US averaged 74.37 degrees Fahrenheit (23.54 degrees Celsius), breaking the 1936 Dust Bowl record by nearly 0.4 degrees Fahrenheit.",
          "kind": "figure",
          "outlet": "NPR World",
          "url": "https://www.npr.org/2026/09/10/nx-s1-5964676/scientists-august-hottest",
          "source_kind": "fulltext"
        }
      ]
    },
