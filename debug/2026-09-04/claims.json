      "distinct_outlets": 4,
      "source_kinds": {
        "fulltext": 10
      },
      "claims": [
        {
          "id": 39,
          "cluster_id": 3,
          "text": "The disappearance of anchovies along the South American Pacific coast is signaling a major El Niño event.",
          "kind": "event",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/features/2026/9/3/el-nino-a-phenomenon-supercharged-by-climate-change?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 40,
          "cluster_id": 3,
          "text": "UK Met Office projections indicate equatorial Pacific ocean temperatures could spike by 3 degrees Celsius when El Niño peaks in late 2026 or early 2027.",
          "kind": "figure",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/features/2026/9/3/el-nino-a-phenomenon-supercharged-by-climate-change?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 41,
          "cluster_id": 3,
          "text": "WMO Secretary-General Celeste Saulo stated: \"Never before in the 50-year history of the WMO have we launched such a major mobilisation delivering forecasts and services to save lives and livelihoods.\"",
          "kind": "quote",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/features/2026/9/3/el-nino-a-phenomenon-supercharged-by-climate-change?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 42,
          "cluster_id": 3,
          "text": "The British government is planning a public campaign advising citizens to stock up on tinned food and water for national emergencies.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/environment/2026/sep/03/angela-eagle-uk-stock-up-supplies-el-nino-warning",
          "source_kind": "fulltext"
        },
        {
          "id": 43,
          "cluster_id": 3,
          "text": "Ocean temperatures at the center of El Niño measured 2.6 degrees Celsius above the 30-year average, with models forecasting a peak of 4 degrees Celsius in November.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/environment/2026/sep/03/angela-eagle-uk-stock-up-supplies-el-nino-warning",
          "source_kind": "fulltext"
        },
        {
          "id": 44,
          "cluster_id": 3,
          "text": "UN Secretary-General António Guterres stated that \"El Niño is being supersized before our eyes.\"",
          "kind": "quote",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/environment/2026/sep/03/angela-eagle-uk-stock-up-supplies-el-nino-warning",
          "source_kind": "fulltext"
        },
        {
          "id": 45,
          "cluster_id": 3,
          "text": "The World Food Programme estimated that El Niño is likely to push about 50 million people into acute hunger.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/environment/2026/sep/03/angela-eagle-uk-stock-up-supplies-el-nino-warning",
          "source_kind": "fulltext"
        },
        {
          "id": 46,
          "cluster_id": 3,
          "text": "Indonesia's Health Ministry recorded over 50,000 cases of respiratory infections linked to wildfires between July and August, including more than 12,000 cases in children under five.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/clyqw44w142o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 47,
          "cluster_id": 3,
          "text": "Professor Bambang Hero Saharjo stated research indicates this year's El Niño could cause wildfires to burn up to 11 million hectares in Indonesia.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/clyqw44w142o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 48,
          "cluster_id": 3,
          "text": "The World Meteorological Organization warned that the current El Niño could be the strongest recorded since records began four decades ago.",
          "kind": "event",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/video/20260903-wmo-chief-says-el-nino-could-be-strongest-in-four-decades",
          "source_kind": "fulltext"
        }
      ]
    },
