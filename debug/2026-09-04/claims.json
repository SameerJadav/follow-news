          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/machado-venezuela-more-us-oil-deal-6361361",
          "source_kind": "fulltext"
        },
        {
          "id": 32,
          "cluster_id": 2,
          "text": "US Energy Secretary Chris Wright traveled to Venezuela to oversee agreement signings with Chevron, GE Vernova, and ENI.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/machado-venezuela-more-us-oil-deal-6361361",
          "source_kind": "fulltext"
        },
        {
          "id": 33,
          "cluster_id": 2,
          "text": "Interim leader Delcy Rodriguez estimated Venezuela will make $209 billion in profit from the energy deals over 25 years.",
          "kind": "figure",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/machado-venezuela-more-us-oil-deal-6361361",
          "source_kind": "fulltext"
