          "source_kind": "fulltext"
        },
        {
          "id": 18,
          "cluster_id": 0,
          "text": "US Trade Representative Jamieson Greer accused Canada of causing the collapse by declining to finalise a deal despite receiving favourable terms.",
          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/rest-of-world/cannot-accept-what-us-has-offered-canada-pm-carney-defiant-as-trade-talks-collapse/articleshow/133426914.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 19,
          "cluster_id": 0,
          "text": "The US and Canada traded $880bn worth of goods and services last year.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/aug/22/canada-tariffs-trump-trade-deal-talks-fail",
