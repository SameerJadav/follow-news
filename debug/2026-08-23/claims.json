          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/cx272np7vgyo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 13,
          "cluster_id": 0,
          "text": "The new US tariffs on Canadian imports came into force at 12:01 am on Saturday.",
