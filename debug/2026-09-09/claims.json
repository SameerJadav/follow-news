      "claim_count": 14,
      "distinct_outlets": 4,
      "source_kinds": {
        "summary": 1,
        "fulltext": 13
      },
      "claims": [
        {
          "id": 18,
          "cluster_id": 1,
          "text": "Twelve countries, including Britain, France, Spain, and Canada, acted together in introducing or considering measures against trade with Israeli settlements in the West Bank.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c5ydlex9yn3o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 19,
          "cluster_id": 1,
          "text": "Israel ordered the closure of the UK's consulate in East Jerusalem and removed British representatives from the International Gaza Support Centre.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c5ydlex9yn3o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 20,
          "cluster_id": 1,
          "text": "The UK government banned goods from Israeli West Bank settlements, restricted services to settlements, and placed limits on arms sales that contribute to the occupation.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c5ydlex9yn3o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 21,
          "cluster_id": 1,
          "text": "British Foreign Secretary Ed Miliband stated that settler terrorism in parts of the West Bank amounted to ethnic cleansing of Palestinians while the Israeli government turned a blind eye.",
          "kind": "quote",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c5ydlex9yn3o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 22,
          "cluster_id": 1,
          "text": "Palestinian ambassador Dr Husam Zomlot called the British government's trade decision a turning point in the UK-Palestine relationship.",
          "kind": "quote",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c5ydlex9yn3o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 23,
          "cluster_id": 1,
          "text": "Israel announced the shutdown of the UK Consulate in occupied East Jerusalem following Britain's ban on settlement goods.",
          "kind": "event",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/video/newsfeed/2026/9/8/what-the-uk-ban-on-goods-from-illegal-israeli-settlements-really-means?traffic_source=rss",
          "source_kind": "summary"
        },
        {
          "id": 24,
          "cluster_id": 1,
          "text": "Israeli Foreign Minister Gideon Sa'ar announced retaliatory measures against the UK, including entry bans on 12 Britons such as former Labour leader Jeremy Corbyn and 10 MPs.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/politics/live/2026/sep/08/uk-us-trade-israel-sanctions-labour-ed-miliband-farage-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 25,
          "cluster_id": 1,
          "text": "UK Prime Minister Andy Burnham stated that targeted measures were brought forward not against the Israeli people, but in support of a two-state solution.",
          "kind": "quote",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/politics/live/2026/sep/08/uk-us-trade-israel-sanctions-labour-ed-miliband-farage-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 26,
          "cluster_id": 1,
          "text": "UK Conservative Party leader Kemi Badenoch criticized the British government's decision to ban settlement trade and accused the Labour government of antisemitism.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/politics/live/2026/sep/08/uk-us-trade-israel-sanctions-labour-ed-miliband-farage-latest-news-updates",
          "source_kind": "fulltext"
        },
        {
          "id": 27,
          "cluster_id": 1,
          "text": "Britain, France, and Canada announced trade restrictions blocking imports from Israeli West Bank settlements.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/israels-foreign-minister-says-it-closing-british-consulate-in-east-jerusalem-6370516",
          "source_kind": "fulltext"
        },
        {
          "id": 28,
          "cluster_id": 1,
          "text": "Canadian Foreign Minister Anita Anand stated on X that illegal settlements in the West Bank significantly undermine long-term peace objectives.",
          "kind": "quote",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/israels-foreign-minister-says-it-closing-british-consulate-in-east-jerusalem-6370516",
          "source_kind": "fulltext"
        },
        {
          "id": 29,
          "cluster_id": 1,
          "text": "France cited the frenzied expansion of settlements and a flare-up of violence as its rationale for banning West Bank settlement goods.",
          "kind": "quote",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/israels-foreign-minister-says-it-closing-british-consulate-in-east-jerusalem-6370516",
          "source_kind": "fulltext"
        },
        {
          "id": 30,
          "cluster_id": 1,
          "text": "US Secretary of State Marco Rubio stated Washington will not follow Britain, France, and Canada in blocking imports from Israeli settlements.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/israels-foreign-minister-says-it-closing-british-consulate-in-east-jerusalem-6370516",
          "source_kind": "fulltext"
        },
        {
          "id": 31,
          "cluster_id": 1,
          "text": "Israel announced plans for 1,000 new West Bank homes on Tuesday.",
          "kind": "figure",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/israels-foreign-minister-says-it-closing-british-consulate-in-east-jerusalem-6370516",
          "source_kind": "fulltext"
        }
      ]
    },
