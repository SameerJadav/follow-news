      "distinct_outlets": 4,
      "source_kinds": {
        "fulltext": 13
      },
      "claims": [
        {
          "id": 15,
          "cluster_id": 1,
          "text": "French Interior Minister Laurent Nuñez reported that 1,747 people were arrested on Friday during widespread student protests.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/ck3r5dxxwqzpo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 16,
          "cluster_id": 1,
          "text": "French Justice Minister Gérard Darmanin stated that 735 out of France's 3,700 schools were affected by violent demonstrations.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/ck3r5dxxwqzpo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 17,
          "cluster_id": 1,
          "text": "French Education Minister Édouard Geffray stated that the student protest movement had been hijacked by individuals who were not students.",
          "kind": "quote",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/ck3r5dxxwqzpo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 18,
          "cluster_id": 1,
          "text": "A 17-year-old was arrested in Belfort, north-eastern France, on suspicion of attempted homicide following an attack on a police officer.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/ck3r5dxxwqzpo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 19,
          "cluster_id": 1,
          "text": "At least 65 education staff members were injured during the student unrest in France.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/ck3r5dxxwqzpo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 20,
          "cluster_id": 1,
          "text": "The regional government reported that Nelson Mandela high school in Nantes suffered more than €2 million in damage due to fire.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/ck3r5dxxwqzpo?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 21,
          "cluster_id": 1,
          "text": "The French Ministry of National Education stated that 564 schools were affected on Friday and nearly 400 high schools were expected to stay closed.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/europe/fires-clashes-and-mass-arrests-as-student-protests-turn-violent-in-france-video/articleshow/134644452.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 22,
          "cluster_id": 1,
          "text": "Education Minister Edouard Geffray stated that more than 1,200 high schools have experienced disruptions or blockades during the protests.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/europe/fires-clashes-and-mass-arrests-as-student-protests-turn-violent-in-france-video/articleshow/134644452.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 23,
          "cluster_id": 1,
          "text": "French authorities reported more than 1,900 arrests and 305 police officer injuries on Thursday.",
          "kind": "figure",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/europe/fires-clashes-and-mass-arrests-as-student-protests-turn-violent-in-france-video/articleshow/134644452.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 24,
          "cluster_id": 1,
          "text": "Fires damaged the entrances of Léonard de Vinci high school and Gaston-Bachelard high school in Paris on Friday morning.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/oct/02/student-protests-shut-schools-across-france",
          "source_kind": "fulltext"
        },
        {
          "id": 25,
          "cluster_id": 1,
          "text": "The French Education Ministry reported that 65 education staff members were injured, including 40 school principals.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/oct/02/student-protests-shut-schools-across-france",
          "source_kind": "fulltext"
        },
        {
          "id": 26,
          "cluster_id": 1,
          "text": "Roughly 400 secondary schools across France were closed on Friday, October 2.",
          "kind": "figure",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/world/why-are-french-students-taking-to-the-streets-around-400-schools-shut-as-protests-spread-across-the-country-11790945864117.html",
          "source_kind": "fulltext"
        },
        {
          "id": 27,
          "cluster_id": 1,
          "text": "According to Le Monde, over 1,020 schools were affected by strikes or protests on Thursday, including 222 blockades.",
          "kind": "figure",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/world/why-are-french-students-taking-to-the-streets-around-400-schools-shut-as-protests-spread-across-the-country-11790945864117.html",
          "source_kind": "fulltext"
        }
      ]
    },
