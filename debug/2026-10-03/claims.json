          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/trump-diesel-export-ban-europe-6428441",
          "source_kind": "fulltext"
        },
        {
          "id": 2,
          "cluster_id": 0,
          "text": "Donald Trump praised European countries for agreeing to release fuel from their strategic reserves.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/trump-diesel-export-ban-europe-6428441",
          "source_kind": "fulltext"
        },
        {
          "id": 3,
          "cluster_id": 0,
          "text": "Donald Trump first expressed support for a US diesel export ban on September 22.",
          "kind": "background",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/trump-diesel-export-ban-europe-6428441",
          "source_kind": "fulltext"
        },
        {
          "id": 4,
          "cluster_id": 0,
          "text": "G7 countries agreed to release 100 million barrels of diesel and crude oil from their reserves over four months.",
