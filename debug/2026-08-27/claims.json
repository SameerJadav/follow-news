          "source_kind": "summary"
        },
        {
          "id": 29,
          "cluster_id": 3,
          "text": "Meta agreed to pay $17 billion to settle claims filed by 47 US states over social media addiction and harm to teenagers.",
          "kind": "figure",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/americas/20260826-meta-reaches-17-billion-settlement-with-us-states-over-social-media-harm-teens",
          "source_kind": "fulltext"
        },
        {
          "id": 30,
          "cluster_id": 3,
          "text": "Under the settlement with US states, Meta agreed to implement a hard cap on daily time limits and daytime school hour notification pauses on Instagram and Facebook.",
          "kind": "event",
          "outlet": "France 24",
          "url": "https://www.france24.com/en/americas/20260826-meta-reaches-17-billion-settlement-with-us-states-over-social-media-harm-teens",
          "source_kind": "fulltext"
        },
        {
          "id": 31,
          "cluster_id": 3,
          "text": "Meta proposed a 2-hour daily usage cap across its platforms for users under the age of 18 as part of the proposed settlement.",
          "kind": "figure",
          "outlet": "DW World",
          "url": "https://www.dw.com/en/meta-settles-in-us-states-lawsuit-on-teen-user-addiction/a-78512157?maca=en-rss-en-world-4025-rdf",
          "source_kind": "fulltext"
        },
        {
          "id": 32,
          "cluster_id": 3,
          "text": "Meta stated that 30% of its settlement payment is conditional on YouTube and TikTok implementing matching daily limits and safety features.",
          "kind": "event",
          "outlet": "DW World",
          "url": "https://www.dw.com/en/meta-settles-in-us-states-lawsuit-on-teen-user-addiction/a-78512157?maca=en-rss-en-world-4025-rdf",
          "source_kind": "fulltext"
        },
        {
          "id": 33,
          "cluster_id": 3,
          "text": "Meta agreed to a $16.68 billion settlement with 29 US states over child data collection and teen addiction claims.",
          "kind": "figure",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/us-news/meta-settles-with-29-us-states-over-claims-of-harm-to-children-on-facebook-instagram-check-details-11787749645263.html",
          "source_kind": "fulltext"
        },
        {
          "id": 34,
          "cluster_id": 3,
          "text": "In a previous lawsuit filed by New Mexico, Meta was ordered to pay $375 million by a jury in March and $567 million by a judge on August 6.",
          "kind": "figure",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/us-news/meta-settles-with-29-us-states-over-claims-of-harm-to-children-on-facebook-instagram-check-details-11787749645263.html",
          "source_kind": "fulltext"
        }
      ]
    },
