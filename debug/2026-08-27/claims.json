      "batch_position": 3,
      "claim_count": 7,
      "distinct_outlets": 4,
      "source_kinds": {
        "fulltext": 6,
        "summary": 1
      },
      "claims": [
        {
          "id": 28,
          "cluster_id": 3,
          "text": "Meta agreed to pay up to $17.1 billion in a settlement with US states over child safety.",
          "kind": "figure",
          "outlet": "Al Jazeera",
