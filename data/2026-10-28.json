      "claims": [
        {
          "id": 20,
          "text": "Brazilian Senator Flávio Bolsonaro left Brazil for the United States following his runoff election defeat to incumbent President Luiz Inácio Lula da Silva.",
          "kind": "event",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/us-news/after-stunning-election-defeat-fl-vio-bolsonaro-flees-to-us-brazils-president-lula-da-silva-calls-it-shameful-11793149546292.html",
          "source_kind": "fulltext"
        },
        {
          "id": 21,
          "text": "Incumbent President Luiz Inácio Lula da Silva secured a fourth term as president of Brazil with 51.8% of the vote.",
          "kind": "figure",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/us-news/after-stunning-election-defeat-fl-vio-bolsonaro-flees-to-us-brazils-president-lula-da-silva-calls-it-shameful-11793149546292.html",
          "source_kind": "fulltext"
        },
        {
          "id": 22,
          "text": "Valdemar Costa Neto, president of the Liberal Party, announced that the party acknowledges the results of the presidential runoff election.",
          "kind": "event",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/us-news/after-stunning-election-defeat-fl-vio-bolsonaro-flees-to-us-brazils-president-lula-da-silva-calls-it-shameful-11793149546292.html",
          "source_kind": "fulltext"
        },
        {
          "id": 23,
          "text": "President Lula called Flávio Bolsonaro's departure shameful, stating that a person who sneaks out of their country must have something to hide.",
          "kind": "quote",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/us-news/after-stunning-election-defeat-fl-vio-bolsonaro-flees-to-us-brazils-president-lula-da-silva-calls-it-shameful-11793149546292.html",
          "source_kind": "fulltext"
        },
        {
          "id": 24,
          "text": "Former President Jair Bolsonaro is currently serving a 27-year prison sentence in Brazil for plotting a coup.",
          "kind": "background",
          "outlet": "Livemint",
          "url": "https://www.livemint.com/news/us-news/after-stunning-election-defeat-fl-vio-bolsonaro-flees-to-us-brazils-president-lula-da-silva-calls-it-shameful-11793149546292.html",
          "source_kind": "fulltext"
        },
        {
          "id": 25,
          "text": "Brazil's Supreme Court ordered Flávio Bolsonaro to surrender his passports amid an investigation into money laundering.",
          "kind": "event",
          "outlet": "Al Jazeera",
          "url": "https://www.aljazeera.com/video/newsfeed/2026/10/27/president-lula-calls-bolsonaros-brazil-exit?traffic_source=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 27,
          "text": "Two sources told Reuters that Flávio Bolsonaro's passports were cancelled after he failed to comply with a Supreme Court order to surrender them within 24 hours.",
          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/rest-of-world/flavio-bolsonaro-flees-brazil-after-lula-defeat-us-offers-visas-to-family/articleshow/135247888.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 28,
          "text": "A senior Brazilian federal police official stated Flávio Bolsonaro did not leave Brazil through any official migration checkpoint.",
          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/rest-of-world/flavio-bolsonaro-flees-brazil-after-lula-defeat-us-offers-visas-to-family/articleshow/135247888.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 33,
          "text": "Argentinian news channel Todo Noticias reported that Flávio Bolsonaro crossed the border into Argentina on foot before abandoning plans to board a private jet.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/oct/27/flavio-bolsonaro-brazil-argentina-fled",
          "source_kind": "fulltext"
        },
        {
          "id": 34,
          "text": "Argentina's security ministry and migration authorities denied that Flávio Bolsonaro entered Argentina.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/bolsonaro-brazil-election-defeat-lula-us-6497941",
          "source_kind": "fulltext"
        },
        {
          "id": 26,
          "text": "A senior U.S. State Department official confirmed to Reuters that entry visas would be issued to Flávio Bolsonaro and his family.",
          "kind": "event",
          "outlet": "Times of India",
          "url": "https://timesofindia.indiatimes.com/world/rest-of-world/flavio-bolsonaro-flees-brazil-after-lula-defeat-us-offers-visas-to-family/articleshow/135247888.cms",
          "source_kind": "fulltext"
        },
        {
          "id": 31,
          "text": "Flávio Bolsonaro has held Italian citizenship and an Italian passport since 2023.",
          "kind": "background",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/oct/27/flavio-bolsonaro-brazil-argentina-fled",
          "source_kind": "fulltext"
        },
        {
          "id": 32,
          "text": "Flávio Bolsonaro is under investigation by Brazilian federal police for potential involvement in a money-laundering scheme worth about 680 million pounds (905 million dollars) involving betting companies.",
          "kind": "figure",
