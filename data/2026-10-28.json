      "claims": [
        {
          "id": 36,
          "text": "A localized ceasefire in the Russian-occupied city of Oleshky was extended across the wider Kherson region.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c6lye1w9p2l8o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 37,
          "text": "U.S. First Lady Melania Trump and Pope Leo XIV helped broker the humanitarian ceasefire in Oleshky.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c6lye1w9p2l8o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 49,
          "text": "Melania Trump led negotiations with civilian representatives from Russia and Ukraine after receiving briefings from UN officials.",
          "kind": "event",
          "outlet": "NPR World",
          "url": "https://www.npr.org/2026/10/27/g-s1-150037/russia-ukraine-war",
          "source_kind": "fulltext"
        },
        {
          "id": 41,
          "text": "Kremlin spokesman Dmitry Peskov confirmed the truce was proceeding according to plan and acknowledged U.S. mediation efforts led by Melania Trump.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c6lye1w9p2l8o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 38,
          "text": "Ukrainian official David Arakhamia stated the ceasefire across the Kherson region will continue until 22:59 Ukrainian time on Sunday, November 1.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c6lye1w9p2l8o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 39,
          "text": "An estimated 1,700 to 2,000 residents remain trapped in Oleshky without access to food, water, or electricity.",
          "kind": "figure",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c6lye1w9p2l8o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 40,
          "text": "The ceasefire agreement provides for humanitarian aid deliveries to Oleshky followed by civilian evacuations scheduled for Friday.",
          "kind": "event",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c6lye1w9p2l8o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 42,
          "text": "Oleshky had a pre-war population of 24,000 before being captured by Russian forces during the initial days of the invasion in February 2022.",
          "kind": "background",
          "outlet": "BBC World",
          "url": "https://www.bbc.co.uk/news/articles/c6lye1w9p2l8o?at_medium=RSS&at_campaign=rss",
          "source_kind": "fulltext"
        },
        {
          "id": 43,
          "text": "U.S. cable news network Newsmax reported it received exclusive television access to accompany observers entering Oleshky.",
          "kind": "event",
          "outlet": "Channel News Asia",
          "url": "https://www.channelnewsasia.com/world/ukraine-russia-us-brokered-truce-holding-6497861",
          "source_kind": "fulltext"
        },
        {
          "id": 48,
          "text": "Russian missile and drone strikes on Kyiv overnight killed at least one person and wounded 15 others, striking a university campus and bridge infrastructure.",
          "kind": "figure",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/oct/27/oleshky-truce-ukraine-russia-putin",
          "source_kind": "fulltext"
        },
        {
          "id": 50,
          "text": "Russian missile strikes in Kharkiv late Monday killed two people and injured four others.",
          "kind": "figure",
          "outlet": "NPR World",
          "url": "https://www.npr.org/2026/10/27/g-s1-150037/russia-ukraine-war",
          "source_kind": "fulltext"
        },
        {
          "id": 45,
          "text": "Finland's President Alexander Stubb and Norway's Prime Minister Jonas Gahr Støre conducted a phone call with Vladimir Putin regarding peace efforts in Ukraine.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/oct/27/oleshky-truce-ukraine-russia-putin",
          "source_kind": "fulltext"
        },
        {
          "id": 47,
          "text": "Denmark's Prime Minister Mette Frederiksen expressed skepticism and criticized the independent call held with Putin by Norway and Finland.",
          "kind": "event",
          "outlet": "Guardian World",
          "url": "https://www.theguardian.com/world/2026/oct/27/oleshky-truce-ukraine-russia-putin",
          "source_kind": "fulltext"
        }
